#!/bin/sh
# Refuses logs, derived data, site lists and real identifiers before a commit (scripts/git_guard.py).
root="$(git rev-parse --show-toplevel)"
python="$root/.venv/Scripts/python.exe"
[ -x "$python" ] || python="$root/.venv/bin/python"
[ -x "$python" ] || python=python
exec "$python" "$root/scripts/git_guard.py" pre-commit -q
