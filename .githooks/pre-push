#!/bin/sh
# Checks every file in the commits being pushed, then runs scripts/check.py (scripts/git_guard.py).
root="$(git rev-parse --show-toplevel)"
python="$root/.venv/Scripts/python.exe"
[ -x "$python" ] || python="$root/.venv/bin/python"
[ -x "$python" ] || python=python
exec "$python" "$root/scripts/git_guard.py" pre-push "$@" -q
